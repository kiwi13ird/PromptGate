{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "PromptGate",
  "version": "1.4.8",
  "description": "Claude·ChatGPT·Gemini 같은 AI 사이트를 안전하게 쓰도록 보호하고 처리 내역을 알려 주는 기업용 보안 확장 프로그램",
  "key": "",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "notifications"
  ],
  "host_permissions": [
    "http://llm-gateway.local/*",
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://openai.com/*",
    "*://*.openai.com/*",
    "*://oaistatic.com/*",
    "*://*.oaistatic.com/*",
    "*://oaiusercontent.com/*",
    "*://*.oaiusercontent.com/*",
    "*://gemini.google.com/*",
    "*://*.gemini.google.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://anthropic.com/*",
    "*://*.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PromptGate",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "options/options.html",
  "storage": {
    "managed_schema": "managed-policy-schema.json"
  }
}
