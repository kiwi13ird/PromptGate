# Copy to /etc/llm-dashboard/dashboard.env and replace every placeholder.
# Keep mode 0600 and never commit the real file.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=9100
FRONTEND_ORIGIN=http://REPLACE_WITH_DASHBOARD_PUBLIC_IP
LOCAL_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
LOCAL_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
EVENT_INGEST_TOKEN=REPLACE_WITH_LONG_RANDOM_INGEST_TOKEN
DATABASE_URL=postgresql://dashboard_user:REPLACE_WITH_PASSWORD@REPLACE_WITH_PRIVATE_RDS_ENDPOINT:5432/REPLACE_WITH_DATABASE?sslmode=require
