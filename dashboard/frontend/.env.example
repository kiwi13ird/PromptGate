# Public frontend settings only. Never put passwords, keys or session values in VITE_*.
VITE_API_MODE=real
VITE_API_BASE_URL=/
VITE_HTTP_TIMEOUT_MS=10000
# Protected-document upload only (20 MiB at about 1.5 Mbps).
VITE_UPLOAD_TIMEOUT_MS=120000
VITE_ENABLE_DEBUG_TOOLS=false

# Development-only proxy target; use your team's local/development backend.
# The frontend package does not include a backend or database.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:9100
