[Unit]
Description=LLM Security Gateway candidate on port 8081
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/llm-gateway
EnvironmentFile=/etc/llm-gateway/dashboard.env
ExecStart=/home/ubuntu/llm-gateway/.venv/bin/mitmdump --listen-port 8081 --set block_global=false -s /home/ubuntu/llm-gateway/gateway.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
