[Unit]
Description=Detection API (windowhash) - uvicorn
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=ubuntu
WorkingDirectory=/opt/detection/src
Environment=REDIS_PASSWORD=<REDIS_PASSWORD>
Environment=REDIS_DB=3
ExecStart=/opt/detection/src/.venv/bin/uvicorn detection_service.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
